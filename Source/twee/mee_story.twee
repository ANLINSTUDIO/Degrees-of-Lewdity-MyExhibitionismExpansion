:: == 随处脱衣 ============================== [widget]
<<widget "clothingCaptionButtonContainerDisable">> <<if window.mee>>
    <<if !mee.isSafeAreaForClothes() or mee.isInEvent()>>
        <<switch mee.clothingCaptionButtonContainerDisabled>>
            <<case undefined>>
                <div class="clothing-caption-button-container-disable"/>
            <<case 1>>
                <div class="clothing-caption-button-container-disable disabled"/>
        <</switch>>
    <<else>>
        <<switch mee.clothingCaptionButtonContainerDisabled>>
            <<case 1>>
                <div class="clothing-caption-button-container-disable disabled"/>
        <</switch>>
    <</if>>
<</if>> <</widget>>
<<widget "clothingCaptionButtonContainerDisableDo">> <<if window.mee>>
    <<if !mee.isSafeAreaForClothes() or mee.isInEvent()>>
        <<switch mee.clothingCaptionButtonContainerDisabled>>
            <<case undefined>>
                <<run setTimeout(()=>{$(".clothing-caption-button-container-disable").addClass("disabled")})>>
                <<set mee.clothingCaptionButtonContainerDisabled to 1>>
        <</switch>>
    <<else>>
        <<switch mee.clothingCaptionButtonContainerDisabled>>
            <<case 1>>
                <<run setTimeout(()=>{$(".clothing-caption-button-container-disable").removeClass("disabled")})>>
                <<set mee.clothingCaptionButtonContainerDisabled to undefined>>
        <</switch>>
    <</if>>
<</if>> <</widget>>

<<widget "wearButton">>
    <<set _worn_id to _args[0].id>>
    <<set _worn_k to _args[0].type>>
    <<set _worn to _args[0].clothes>>
    <<set _worn_name to _args[0].clothes.cn_name_cap??_args[0].clothes.name>>
    <<set _worn_outfit to _args[0].outfit?" outfit":"">>
    <<set _worn_discarded to _args[0].discarded?" discarded":"">>
    <<set _extratext to "">>
    <<set _extratext += _args[0].outfit?" | <span class='gold'>套装</span>":"">>
    <div @class="'clothing-caption-button'+_worn_outfit+_worn_discarded" @onclick=_args[1]>
        <div class="clothing-caption-button-icon">
            <<clothingicon _worn _worn_k>>
        </div>
        <div class="clothing-caption-button-overlay">
            <<set _integritymax to setup.clothes[_worn_k].find((a)=>{return a.name===_args[0].clothes.name})?.integrity_max>>
            <<if _integritymax and _integritymax gt 0>>
                <<if _worn.integrity gt (_integritymax * 9 / 10)>>
                    <<set _output to 0>>
                <<elseif _worn.integrity gt (_integritymax * 5 / 10)>>
                    <<set _output to "<span class='teal'>磨损</span>">>
                <<elseif _worn.integrity gt (_integritymax * 2 / 10)>>
                    <<set _output to "<span class='purple'>撕裂</span>">>
                <<else>>
                    <<set _output to "<span class='red'>破烂</span>">>
                <</if>>
                <<if _output isnot 0>>
                    <<set _extratext += " | "+_output>>
                    <div class="clothing-caption-button-overlay-container">
                        <<print _output>>
                    </div>
                <</if>>
            <</if>>
            <<if _worn.wet>>
                <<switch mee.getWetStage(_worn.wet)>>
                    <<case 1>><<set _extratext += " | <span class='teal'>湿润</span>">>
                    <<case 2>><<set _extratext += " | <span class='purple'>潮湿</span>">>
                    <<case 3>><<set _extratext += " | <span class='red'>湿透</span>">>
                <</switch>>
                <div class="clothing-caption-button-overlay-container">
                    <<for _i to 0; _i lt mee.getWetStage(_worn.wet); _i++>>
                        <div class="clothing-caption-button-overlay-drop"></div>
                    <</for>>
                </div>
            <</if>>
        </div>
        <<set _label to _wardrobeLinks.find(item => item.id === _worn_k)?.label ?? _worn_k>>
        <div class="clothing-caption-button-title">
            <div>_label</div>
            <div>_worn_name<<print _extratext>></div>
        </div>
    </div>
<</widget>>

<<widget "clothingCaptionButton">> <<if window.mee>>
    <div id="clothing-caption-button-temp" style="display: none"><<wardrobeLinks>></div><<run setTimeout(()=>{$("#clothing-caption-button-temp").remove()})>>
    
    <<set _onclothes to mee.getOnClothes()>>

    <div class="clothing-caption-button-container">
        <<clothingCaptionButtonContainerDisable>>
        <div class="clothing-caption-button" onclick="Wikifier.wikifyEval(`<<overlayReplace 'carriedclothes'>><<replace #customOverlayTitle>><<titleCarriedclothes>><</replace>><<replace #customOverlayContent>><<carriedclothes>><</replace>>`)">
            <div class="clothing-caption-button-icon">
                ...
            </div>
            <div class="clothing-caption-button-title">
                <div>随身携带</div>
                <div>打开你随身携带的衣服</div>
            </div>
        </div>
        <<if _onclothes>>
            <<for _clothes_object range _onclothes>>
                <<set _onclick to 'mee.clothingCaptionButtonClick(false, "'+_clothes_object.type+'")'>>
                <<wearButton _clothes_object _onclick>>
            <</for>>
        <</if>>
    </div>

    <<set _nearbyClothes to mee.getNearbyClothes(_args[0]??true)>>

    <<set _start to "">>
    <<if !_nearbyClothes and !mee.clothingCaptionButtonContainerNearby>>
        <!-- 没有附近衣服 -->
        <<set _start to " start">>
    <<elseif _nearbyClothes and !mee.clothingCaptionButtonContainerNearby>>
        <!-- 进入附近衣服 -->
        <<set _start to " start">>
        <<run setTimeout(()=>{$(".clothing-caption-button-container-nearby.start").removeClass("start")}, mee.展开附近衣服延迟)>>
        <<set mee.clothingCaptionButtonContainerNearby to 1>>
    <<elseif _nearbyClothes and mee.clothingCaptionButtonContainerNearby>>
        <!-- 持续附近衣服 -->
    <<elseif !_nearbyClothes and mee.clothingCaptionButtonContainerNearby>>
        <!-- 离开附近衣服 -->
        <<run setTimeout(()=>{$(".clothing-caption-button-container-nearby").addClass("start")}, mee.展开附近衣服延迟)>>
        <<set mee.clothingCaptionButtonContainerNearby to undefined>>
    <</if>>
    
    <div @class="'clothing-caption-button-container-nearby '+_start"><div>
        <div style="margin-bottom: -10px; font-size: small;">附近的衣服: </div>
        <div class="clothing-caption-button-container">
            <<if _nearbyClothes>>
                <<clothingCaptionButtonContainerDisable>>
                <<for _clothes_object range _nearbyClothes>>
                    <<set _onclick to 'mee.clothingCaptionButtonClick(true, "'+_clothes_object.id+'")'>>
                    <<wearButton _clothes_object _onclick>>
                <</for>>
            <<else>>
                <div class="clothing-caption-button"/>
            <</if>>
        </div>
    </div></div>

    <<if _clothesChanged>>
        <br>
        <<button [[继续|$passage]]>><</button>>
    <</if>>

    <<if _clothesChanged or _tipChanged>>
        <small id="clothing-caption-tip">部分选项产生于更换衣服之前，点击更新选项和当前剧情（可选，正在事件时谨慎使用）</small>
    <</if>>

    <<if !mee.isSafeAreaForClothes() and !mee.isInEvent() and !mee.isProhibitAreaForClothes()>>
        <br>
        <<button "<div id='mee-add-safe-area-for-clothes-button'>我确定这里可以安全地放我的衣服！</div>">><<run mee.addSafeAreaForClothes()>><</button>>
        <small class="red">由于不是主要区域，需要你手动判断此处是否安全可靠</small>
    <</if>>
    
    <<clothingCaptionButtonContainerDisableDo>>
<</if>> <</widget>>

<<widget "titleCarriedclothes">>
    <<setupTabs>>
    <div id="titleCarriedclothes"/>
	<div id="overlayTabs" class="tab">
		<<closeButtonMobile>>
		<<button "随身携带">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<carriedclothes>><</replace>>
		<</button>>
	</div>
	<<closeButton>>
<</widget>>

<<widget "carriedclothes">>
    <div id="clothing-takeback-button-temp" style="display: none"><<wardrobeLinks>></div><<run setTimeout(()=>{$("#clothing-takeback-button-temp").remove()})>>
    <<run mee.getCarrySpace()>>
	<<set _carriedClothes to mee.getGroundClothes("Carried")>>
    <<set _count to 0>>
    <div class="settingsToggleItem">
        <div class="clothing-takeback-button-container">
            <<if _carriedClothes>>
                <<for _clothes_object range _carriedClothes>>
                    <<set _count++>>
                    <<set _onclick to 'mee.getClothesFromCarried("'+_clothes_object.id+'")'>>
                    <<wearButton _clothes_object _onclick>>
                <</for>>
            <</if>>
            <<for _i to 0; _i lt mee.getCarrySpace()[0]-_count; _i++>>
                <div class="clothing-caption-button"/>
            <</for>>
        </div>
    </div>
<</widget>>

:: == 满足系统 ============================== [widget]
<<widget "meecaptions">> <<if window.mee>>
    <<set _courage to mee.courage()>>
    <<set _couragelevel to mee.couragelevel()>>
	<<if Number.isFinite(_courage)>>
		<div id="couragecaption" @title="'勇气: ' + _courage.toFixed(2) + ' | 高勇气值可以帮助突破淫乱、暴露、异种的数值判定'">
			<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
				勇气：
				<<if $options.showCaptionText is true>>
                    <<switch _couragelevel>>
                        <<case 4>>
                            <span class="green">你过于冲动了。</span>
                        <<case 3>>
                            <span class="teal">你勇气可嘉。</span>
                        <<case 2>>
                            <span class="lblue">你很大胆。</span>
                        <<case 1>>
                            <span class="purple">你胆子不大。</span>
                        <<case 0>>
                            <span class="pink">你没有勇气。</span>
                    <</switch>>
				<</if>>
			</div>
			<<set _showCaptionText to !$options.showCaptionText>>
			<<set _statkey to "couragecaption">><<statbarinverted _courage 1000 _showCaptionText>>
		</div>
	<</if>>

    <<set _calm to mee.calm()>>
    <<set _calmlevel to mee.calmlevel()>>
	<<if Number.isFinite(_calm)>>
		<div id="calmcaption" @title="'镇静: ' + _calm.toFixed(2) + ' | 高镇静时疼痛、性奋、压力提升速度减慢'">
			<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
				镇静：
				<<if $options.showCaptionText is true>>
                    <<switch _calmlevel>>
                        <<case 4>>
                            <span class="green">你心如止水。</span>
                        <<case 3>>
                            <span class="teal">你临危不乱。</span>
                        <<case 2>>
                            <span class="lblue">你遇事从容不迫。</span>
                        <<case 1>>
                            <span class="purple">你难得冷静下来。</span>
                        <<case 0>>
                            <span class="pink">你心浮气躁。</span>
                    <</switch>>
				<</if>>
			</div>
			<<set _showCaptionText to !$options.showCaptionText>>
			<<set _statkey to "calmcaption">><<statbarinverted _calm 1000 _showCaptionText>>
		</div>
	<</if>>

	<<if Number.isFinite($desire)>>
		<div id="desirecaption" @title="'欲望: ' + $desire.toFixed(2) + ' | 高欲望时勇气增加、镇静减少，低欲望时反之；高潮将会减少50%欲望，有助于增加镇静，减缓负面效果提升速度'">
			<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
				欲望：
				<<if $options.showCaptionText is true>>
					<<if $desire gte 800>>
						<span class="pink">你欲求不满。</span>
					<<elseif $desire gte 600>>
						<span class="purple">你性欲旺盛。</span>
					<<elseif $desire gte 400>>
						<span class="blue">你的欲望很正常。</span>
					<<elseif $desire gte 200>>
						<span class="lblue">你提不起性趣。</span>
					<<else>>
						<span class="teal">你处于贤者时间。</span>
					<</if>>
				<</if>>
			</div>
			<<set _showCaptionText to !$options.showCaptionText>>
			<<set _statkey to "desirecaption">><<statbar 0 $desire 1000 _showCaptionText>>
		</div>
	<</if>>

	<<if Number.isFinite($satisfaction)>>
		<div id="satisfactioncaption" @title="'满足: ' + $satisfaction.toFixed(2) + ' | 满足感值为勇气和镇静的基础值'">
			<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
				满足：
				<<if $options.showCaptionText is true>>
                    <<if $satisfaction gte 800>>
						<span class="green">你如愿以偿。</span>
					<<elseif $satisfaction gte 600>>
						<span class="teal">你心满意足。</span>
					<<elseif $satisfaction gte 400>>
						<span class="lblue">你感到特别满足。</span>
					<<elseif $satisfaction gte 200>>
						<span class="purple">你觉得无聊。</span>
					<<else>>
						<span class="pink">你感受着时间的不断流逝。</span>
					<</if>>
				<</if>>
			</div>
			<<set _showCaptionText to !$options.showCaptionText>>
			<<set _statkey to "satisfactioncaption">><<statbarinverted $satisfaction 1000 _showCaptionText>>
		</div>
	<</if>>
<</if>> <</widget>>

<<widget "satisfyevent">>
    <<switch _args[1]>>
        <<case "curiosity" "c" "好奇">>
            <<set _output to "好奇心的驱使">>
        <<case "exhibition" "e" "露出">>
            <<set _output to "露出想法">>
        <<default>>
            <<set _output to "这个事件">>
    <</switch>>
    <span class="teal">_args[0] （完成_output会让你感到满足）</span>
<</widget>>

<<widget "gsatisfaction">>
    <<switch _args[0]>>
        <<case "curiosity" "c" "好奇">>
            <span class="teal">你满足了你的好奇心，感到特别满足。</span><<note "+ 满足感" "teal">>
            <<run mee.addSatisfaction(20)>>
        <<case "exhibition" "e" "露出">>
            <span class="teal">你完成了一场酣畅淋漓的露出自慰，感到特别满足。</span><<note "+ 满足感" "teal">>
            <<run mee.addSatisfaction(20)>>
        <<default>>
            <span class="teal">你感到特别满足。</span><<note "+ 满足感" "teal">>
            <<run mee.addSatisfaction(20)>>
    <</switch>>
    <<set $taskstat++>>
<</widget>>

:: == 孤儿院厕所  ===========================
:: Home Toilets
<div id="额外安全放衣区域"/>
<<if !mee.getexcretes()>>
    你在厕所隔间排泄了。<<pass 1>><<llstress>><<stress -12>>
    <<run mee.excrete()>>
    <br><br>
<<else>>
    你的膀胱空荡荡的，已经放不出更多水了。
    <br><br>
<</if>>
<<link [[继续|Bathroom]]>><</link>>

:: == 购物中心厕所 ========================== [widget]
<<widget "settoiletgender">>
    <<set $toiletgender to _args[0]>>
    <<set $night to Time.dayState is "night">>
    <<set $misgender to $player.gender_appearance isnot $toiletgender>>
    <<set $outside to 0>>
    <<set $location to "shopping_centre">>
    <<set $toiletpassage to "Shopping Centre "+($toiletgender === "m"?'Mens':'Womens')+" Toilets">>
<</widget>>

<<widget "toiletgender">>
    <<if $toiletgender is "m">>男<<else>>女<</if>>
<</widget>>

<<widget "shoppingCentreToilets">>
    <div id="额外安全放衣区域"/>
    <<effects>>

    <<if hasSexStat("exhibitionism", 3) or !$misgender or $night>>
        你在购物中心的<<toiletgender>>厕所里。<br>
        <<if $misgender>>
            <<if $daily.entershoptoilet isnot 1>>
                <<if $night>> 晚上的购物中心一片寂静，除了不时巡逻的保安，这里也许非常安全。 <br>
                <<else>> 尽管经你再三确认过，此时的厕所不太可能进人，但是这谁也说不准。 <<exhibitionismN 3>>
                <</if>>
                <<set $daily.entershoptoilet to 1>>
                <<unset $action>> <!-- 防止有人没清空 -->
            <<else>>
                这不是你该待的地方。<br><br>
            <</if>>
        <</if>>

        <<switch $action>>
            <<case "Wash">>
                <<if setup.bodyliquid.combined("face") gte 1>>
                    <<if $skin.left_cheek.pen is "pen" or $skin.right_cheek.pen is "pen" or $skin.forehead.pen is "pen">>
                        你在水槽边弯下腰洗掉了脸上的淫液和墨水。
                    <<elseif $skin.left_cheek.pen is "lipstick" or $skin.right_cheek.pen is "lipstick" or $skin.forehead.pen is "lipstick">>
                        你在水槽边弯下腰洗掉了脸上的淫液和口红印。
                    <<elseif $skin.left_cheek.pen is "mud" or $skin.right_cheek.pen is "mud" or $skin.forehead.pen is "mud">>
                        你在水槽边弯下腰洗去了脸上的淫液和泥巴。
                    <<else>>
                        你在水槽边弯下腰洗掉了脸上的淫液。
                    <</if>>
                <<elseif $skin.left_cheek.pen is "lipstick" or $skin.right_cheek.pen is "lipstick" or $skin.forehead.pen is "lipstick">>
                    你在水槽边弯下腰洗掉了脸上的口红印。
                <<elseif $skin.left_cheek.pen is "mud" or $skin.right_cheek.pen is "mud" or $skin.forehead.pen is "mud">>
                    你在水槽边弯下腰洗掉了脸上的泥巴。
                <<else>>
                    你在水槽边弯下腰洗掉了脸上的墨水。
                <</if>>
                <<wash_face>>
                <br><br>
            <<case "Rinse">>
                你弯下腰，将嘴对准水龙头开始漱口。
                <<wash_mouth>>
                <br><br>
        <</switch>>
        <<unset $action>>
        <br>

        <<if $stress gte $stressmax>>
            <<passoutshop>>
        <<else>>
            <<cleareventpool>>
            
            <<addinlineevent "eventSafe" 10>>
                <!-- <<if hasSexStat("exhibitionism", 5) and Time.dayState is "day" and $exposed gte 2 and !$daily.shoppingcentreStreak>>
                    <span class="lewd">赤身裸体地站在洗手间里，你有一种想裸奔穿过公园的淫荡冲动。很多人会看到你的。</span>
                    <br><br>
                    <<ind>><<link [[裸奔|Shopping Centre Streak]]>><<set $daily.shoppingcentreStreak to true>><<pass 1>><<arousal 100>><</link>><<exhibitionist5>><<garousal>>
                    <br>
                <<elseif hasSexStat("exhibitionism", 4)>>
                    <span class="lewd">一个淫荡的想法冲击着你。</span> 你可以脱光衣服，在某个隔间里等待毫无戒心的路人看到你。
                    <<if Time.dayState is "dusk" or $night>>
                        <br><br>
                        <<skinicon "strip">><<link [[脱光衣服在隔间里等待 (0:20)|$toiletpassage+' Stall']]>><<set $phase to 5>><<pass 20>><</link>><<exhibitionist4>>
                        <br>
                    <<else>>
                        <span class="blue">然而，最好还是等到夜幕降临。</span>
                        <br><br>
                    <</if>>
                <</if>> -->

                <<mirroricon>><<link [[照镜子 (0:02)|Simple Mirror]]>><<pass 2>><<set $previousPassage = $passage>><</link>><br>
                <<if setup.bodyliquid.combined("face") gte 1 or $skin.left_cheek.pen is "pen" or $skin.right_cheek.pen is "pen" or $skin.forehead.pen is "pen" or $skin.left_cheek.pen is "mud" or $skin.right_cheek.pen is "mud" or $skin.forehead.pen is "mud" or $skin.left_cheek.pen is "lipstick" or $skin.right_cheek.pen is "lipstick" or $skin.forehead.pen is "lipstick">>
                    <<bathroomicon "sink">><<link [[洗脸 (0:05)|$passage]]>><<pass 5>><<set $action to "Wash">><</link>><br>
                <</if>>
                <<if setup.bodyliquid.combined("mouth") gte 1>>
                    <<bathroomicon "sink">><<link [[漱口 (0:05)|$passage]]>><<pass 5>><<set $action to "Rinse">><</link>><br>
                <</if>>
                <<if $toiletgender is "m">>
                    <<icon "toilet-urinal.png">><<link [[小便池 (0:01)|$toiletpassage+' Urinal']]>><<set $phase to 1>><</link>><<if $misgender>><<exhibitionist 5>><</if>><br>
                <</if>>
                <<icon "toilet-stall.png">><<link [[寻找一个隔间|$toiletpassage+' Stall']]>><<set $phase to 1>><</link>><br>

                <!-- <<if $exposed gte 2 and hasSexStat("exhibitionism", 3)>>
                    <<sneakicon>><<link [[溜出去|Shopping Centre]]>><</link>><<exhibitionist3>>
                <<elseif $exposed is 1>>
                    <<sneakicon>><<link [[溜出去|Shopping Centre]]>><</link>><<exhibitionist1>>
                <<elseif $exposed lte 0>>
                    <<getouticon>><<link [[离开|Shopping Centre]]>><</link>>
                <</if>> -->
                <<getouticon>><<link [[离开|Shopping Centre]]>><</link>>
            <</addinlineevent>>

            <<if $skip_event is 1>>
                <<unset $skip_event>>
            <<else>>

                <<addinlineevent "eventMenEntry" 1>>
                    <<if $misgender>>
                        你看向镜子里的你，心想这可能是一个……错误的决定？就是进入明明不属于自己的<<toiletgender>>厕所。谁也说不准，如果真的有人会进来呢……<br>
                        正这样想着，你的心脏猛然漏跳一拍，全身猛地一颤，你无法喘气了，以为这样就可以压低自己的声音让别人以为自己不存在。<br><br>
                        门外传来一个<<toiletgender>>人打电话的声音。
                        <br><br>
                        <<icon "toilet-stall.png">><<link [[躲在空隔间内|$toiletpassage+" Stall"]]>><<set $phase to 2>><</link>><br>
                        <<ind>><<link [[继续|$toiletpassage+" Caught"]]>><<set $phase to 2>><<unset $action>><</link>>
                    <<else>>
                        你看向镜子里的你，欣赏着自己的几分姿色。<br>
                        突然门外传来一个<<toiletgender>>人打电话的声音。
                        <br><br>
                        <<rng 3>> <<if $rng is 1>>
                            <<if $daily.commercialRooftopsSexEvent is undefined>>
