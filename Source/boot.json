                    "all": true
                },
                {
                    "tip": "购物中心厕所 代替原版Restroom",
                    "passage": "Shopping Centre",
                    "findString": "|Shopping Centre Restroom]]",
                    "replace": "|Shopping Centre Escape Toilets]]",
                    "all": true
                }
            ]
        },
