                    "findString": "<<clothingCaptionText>>",
                    "replace": "<<clothingCaptionText>><<clothingCaptionButton>>"
                },
                {
                    "tip": "随处脱衣",
                    "passage": "Clothing Shop v2 Widgets",
                    "findString": "<<clothingCaptionText>>",
                    "replace": "<<clothingCaptionText>><<clothingCaptionButton>>"
