{
    "name": "露出拓展-请别露出惊讶的表情好吗",
    "nickName": "请别露出惊讶的表情好吗 - 露出拓展",
    "version": "1.0.4",
    "styleFileList": [
        "style/mee_css.css"
    ],
    "scriptFileList": [
        "js/mee_js.js"
    ],
    "tweeFileList": [
        "twee/mee_story.twee",
        "twee/mee_settings.twee"
    ],
    "imgFileList": [
        "img/misc/icon/lick.png",
        "img/misc/icon/smell.png",
        "img/misc/icon/toilet-stall.png",
        "img/misc/icon/toilet-urinal.png",
        "img/ui/mee-tip.png",
        "img/ui/sym-exhibitionism.png"
    ],
    "additionDir": [],
    "additionFile": [],
    "addonPlugin": [
        {
            "modName": "TweeReplacer",
            "addonName": "TweeReplacerAddon",
            "modVersion": "^1.2.0",
            "params": [
                {
                    "tip": "设置",
                    "passage": "overlayReplace",
                    "findRegex": "<<optionsinformation>><<\\/replace>>[\\s\\S]*?<<\\/button>>",
                    "regexFlag": "g",
                    "replace": "<<optionsinformation>><</replace>>\n\t\t<</button>><<dolmeemodTab>>"
                },
                {
                    "tip": "随处脱衣",
                    "passage": "StoryCaption",
                    "findString": "<<clothingCaptionText>>",
                    "replace": "<<clothingCaptionText>><<clothingCaptionButton>>"
                },
                {
                    "tip": "随处脱衣 - 更新文本",
                    "passage": "Clothing Shop v2 Widgets",
                    "findString": "<<clothingCaptionText>>",
                    "replace": "<<clothingCaptionText>><<clothingCaptionButton false>>"
                },
                {
                    "tip": "满足系统显示侧边栏",
                    "passage": "StoryCaption",
                    "findString": "<<hallucinogencaption>>",
                    "replace": "<<hallucinogencaption>>\n\t\t\t<br>\n\t\t\t<<meecaptions>>"
                },
                {
                    "tip": "勇气 - 淫乱判定文本",
                    "passage": "Widgets Deviancy",
                    "findString": "<<if !hasSexStat(\"deviancy\", $_n, false) and $drunk gte 1>>",
                    "replaceFile": "twee/replacer/courage_deviancyN.twee"
                },
                {
                    "tip": "勇气 - 暴露判定文本",
                    "passage": "Widgets Exhibitionism",
                    "findString": "<<if !hasSexStat(\"exhibitionism\", $_n, false) and $drunk gte 1>>",
                    "replaceFile": "twee/replacer/courage_exhibitionismN.twee"
                },
                {
                    "tip": "勇气 - 异种判定文本",
                    "passage": "Widgets Promiscuity",
                    "findString": "<<if !hasSexStat(\"promiscuity\", $_n, false) and $drunk gte 1>>",
                    "replaceFile": "twee/replacer/courage_promiscuityN.twee"
                },
                {
                    "tip": "镇静 - 疼痛修改 - 战斗用",
                    "passage": "Widgets",
                    "findString": "<<set $pain += (_violence * _painMod",
                    "replace": "<<set _painMod *= (window.mee?.calmStatModifier()??1)>>\n\t\t\t<<set $pain += (_violence * _painMod",
                    "all": true
                },
                {
                    "tip": "镇静 - 压力修改 - 战斗用",
                    "passage": "Widgets",
                    "findString": "<<set $stress += (_violence * _drunkMod * _stressMod",
                    "replace": "<<set _stressMod *= (window.mee?.calmStatModifier()??1)>>\n\t\t\t<<set $stress += (_violence * _drunkMod * _stressMod",
                    "all": true
                },
                {
                    "tip": "移动stats",
                    "passage": "mobileStats",
                    "findString": "<</widget>>\n\n<<widget \"mobileStatsTime\">>",
                    "replaceFile": "twee/replacer/mobilestat.twee"
                },
                {
                    "tip": "孤儿院厕所",
                    "passage": "Bathroom",
                    "findString": "<<personalUpkeep>>",
                    "replaceFile": "twee/replacer/places/孤儿院厕所.twee"
                },
                {
                    "tip": "购物中心厕所",
                    "passage": "Shopping Centre",
                    "findString": "\t\t\t<br>\n\t\t\t<<stairsicon \"up\">><<link [[",
                    "replaceFile": "twee/replacer/places/购物中心厕所.twee",
                    "all": true
                },
                {
                    "tip": "购物中心厕所 代替原版Restroom",
                    "passage": "Shopping Centre",
                    "findString": "|Shopping Centre Restroom]]",
                    "replace": "|Shopping Centre Escape Toilets]]",
                    "all": true
                },
                {
                    "tip": "【露出事件】购物中心更衣室露出",
                    "passage": "Changing Room",
                    "findString": "<div id=\"wardrobeExits\"><<wardrobeExits>></div>",
                    "replaceFile": "twee/replacer/events/【露出事件】购物中心试衣间事件.twee"
                },
                {
                    "tip": "【好奇任务】购物中心楼顶做爱事件",
                    "passage": "Commercial rooftops",
                    "findString": "\t<<if $exposed gte 1>>",
                    "replaceFile": "twee/replacer/tasks/【好奇任务】购物中心楼顶做爱事件.twee"
                }
            ]
        },
        {
            "modName": "ReplacePatcher",
            "addonName": "ReplacePatcherAddon",
            "modVersion": "1.2.0",
            "params": {
                "js": [
                    {
                        "tip": "勇气 - 判定修改",
                        "fileName": "ingame.js",
                        "from": "if (modifiers) {",
                        "to": "if (modifiers) {\n\t\tstatValue += window.mee?.courageStatModifier();\n"
                    },
                    {
                        "tip": "镇静 - 疼痛修改 - 宏用",
                        "fileName": "stat-changes.js",
                        "from": "pain *= 1 - V.sciencetrait / 10;",
                        "to": "pain *= 1 - V.sciencetrait / 10;\n\t\t\t\tpain *= window.mee?.calmStatModifier();"
                    },
                    {
                        "tip": "镇静 - 性奋修改 - 通用",
                        "fileName": "stat-changes.js",
                        "from": "if (V.drugged > 0) {",
                        "to": "mod *= window.mee?.calmStatModifier();\n\t\t\tif (V.drugged > 0) {"
                    },
                    {
                        "tip": "镇静 - 压力修改 - 宏用",
                        "fileName": "stat-changes.js",
                        "from": "V.stress += amount * stressMod;",
                        "to": "V.stress += amount * stressMod * (window.mee?.calmStatModifier()??1);"
                    },
                    {
                        "tip": "欲望 - 性奋修改 （高欲望时性奋更容易提升，低欲望性欲则不容易提升【贤者时间？】）",
                        "fileName": "stat-changes.js",
                        "from": "if (V.drugged > 0) {",
                        "to": "mod *= (V.desire??500) / 500;\n\t\t\tif (V.drugged > 0) {"
                    },
                    {
                        "tip": "欲望 - 性奋影响",
                        "fileName": "stat-changes.js",
                        "from": "V.arousal += amount * mod",
                        "to": "if (amount * mod > 0) window.mee?.addDesire(amount * mod * 0.06);\n\t\t\tV.arousal += amount * mod"
                    },
                    {
                        "tip": "欲望 - 醉酒影响",
                        "0.5.10.12": "[\t\tV.drunk] = Math.clamp(V.drunk + amount * mod, 0, 1000);",
                        "0.5.11.9-1": "[\t\tV.drunk] = Math.clamp(V.drunk, 0, 1000); （此处，没有amount，检测amount无法通过）",
                        "0.5.11.9-2": "[\t\tV.drunk] += amount * mod",
                        "fileName": "stat-changes.js",
                        "from": "\t\tV.drunk",
                        "to": "if (typeof amount !== 'undefined' && amount > 0) window.mee?.addDesire(amount * mod * 0.7);\n\t\tV.drunk",
                        "all": true
                    }
                ]
            }
        },
        {
            "modName": "BeautySelectorAddon",
            "addonName": "BeautySelectorAddon",
            "modVersion": "^2.0.0",
            "params": {
                "type": "(请确保启用此图像包) 请别露出惊讶的表情好吗 - 露出拓展"
            }
        }
    ],
    "dependenceInfo": [
        {
            "modName": "GameVersion",
            "version": ">=0.5.10.12"
        },
        {
            "modName": "TweeReplacer",
            "version": "^1.2.0"
        },
        {
            "modName": "BeautySelectorAddon",
            "version": "^2.0.0"
        }
    ]
}